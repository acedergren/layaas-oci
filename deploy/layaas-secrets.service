[Unit]
Description=Load Layaas API key from OCI Vault
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/opt/laya/venv/bin/python /opt/laya/fetch_secret.py
RemainAfterExit=yes
TimeoutStartSec=720
UMask=0077
RuntimeDirectory=laya-secrets
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes

[Install]
WantedBy=multi-user.target
