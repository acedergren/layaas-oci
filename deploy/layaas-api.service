[Unit]
Description=Layaas CPU API
After=network-online.target layaas-secrets.service
Requires=layaas-secrets.service
ConditionPathExists=/opt/laya/.ready
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
User=laya
Group=laya
WorkingDirectory=/opt/laya
LoadCredential=api-key:/run/laya-secrets/api-key
Environment=HF_HOME=/var/lib/laya/huggingface
Environment=HF_HUB_OFFLINE=1
Environment=LAYA_BIND_HOST=0.0.0.0
Environment=LAYA_PORT=8000
Environment=OMP_NUM_THREADS=1
Environment=TOKENIZERS_PARALLELISM=false
ExecStart=/opt/laya/venv/bin/python /opt/laya/server.py
Restart=on-failure
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/laya
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
MemoryMax=6G
CPUQuota=200%
UMask=0077

[Install]
WantedBy=multi-user.target
